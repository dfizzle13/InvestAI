# Copy to your local environment; do not commit real secrets.
INVESTAI_API_TOKEN=replace-with-a-long-random-secret
INVESTAI_SNAPSHOT_PATH=./snapshot.json

# Configure before first startup; the app never displays the initial password.
INVESTAI_ADMIN_USERNAME=admin
INVESTAI_ADMIN_PASSWORD=replace-with-a-strong-unique-password
INVESTAI_DATABASE_PATH=./investai.sqlite3
